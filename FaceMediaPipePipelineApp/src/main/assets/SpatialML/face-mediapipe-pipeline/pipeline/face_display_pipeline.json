      "outputs": [
        {
          "name": "anchor",
          "tensor": "frame_pose"
        }
      ],
      "script": "var det;\nvar point;\nvar anchor;\nvar score = det[4];\nvar valid = score >= 0.25 && det[2] > det[0] && det[3] > det[1];\nvar px = valid ? point[0] : 0.0;\nvar py = valid ? -point[1] : 0.0;\nvar pz = valid ? point[2] + 0.02 : -6.0;\nvar h = valid ? Math.max(det[3] - det[1], 1.0) : 0.0;\nvar s = valid ? Math.max(h / 1200.0, 0.02) : 0.0001;\nvar zScale = valid ? 0.001 : 0.0001;\nanchor[0] = s;\nanchor[1] = 0.0;\nanchor[2] = 0.0;\nanchor[3] = px;\nanchor[4] = 0.0;\nanchor[5] = s;\nanchor[6] = 0.0;\nanchor[7] = py;\nanchor[8] = 0.0;\nanchor[9] = 0.0;\nanchor[10] = zScale;\nanchor[11] = pz;\nanchor[12] = 0.0;\nanchor[13] = 0.0;\nanchor[14] = 0.0;\nanchor[15] = 1.0;\n"
    }
