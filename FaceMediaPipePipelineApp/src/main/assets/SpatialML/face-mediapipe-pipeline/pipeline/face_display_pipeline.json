      "script": "var det;\nvar uv;\nvar score = det[4];\nvar valid = score >= 0.25 && det[2] > det[0] && det[3] > det[1];\nuv[0] = valid ? Math.round((det[0] + det[2]) * 0.5) : 0;\nuv[1] = valid ? Math.round((det[1] + det[3]) * 0.5) : 0;\n"
